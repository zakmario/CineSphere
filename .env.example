# Copier ce fichier en `.env` (jamais commité) et remplir les valeurs.
#
# Dans l'application FlutterFlow, ces valeurs ne sont pas lues depuis `.env` :
# - TMDB_API_KEY -> FlutterFlow > Settings > Dev Environments > Environment
#                   Values > `tmdbApiKey`
# - Firebase     -> FlutterFlow > Settings > Project Setup > Firebase
#                   (fichiers de configuration générés par FlutterFlow)
# Le fichier `.env` sert aux scripts locaux (tool/seed_firestore.dart).

# Clé API v3 TMDB : https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Projet Firebase visé par le seed.
FIREBASE_PROJECT_ID=cinesphere-app-3f710

# Seed sur l'émulateur (firebase emulators:start) : décommenter.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Seed sur le vrai projet : jeton OAuth d'un compte autorisé, par exemple
# `gcloud auth print-access-token`. Jamais commité.
GOOGLE_ACCESS_TOKEN=
