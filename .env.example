# Copier ce fichier en `.env` (jamais commité) et remplir les valeurs.
#
# Dans l'application FlutterFlow, ces valeurs ne sont pas lues depuis `.env` :
# - TMDB_API_KEY  -> FlutterFlow > Settings > Dev Environments > Environment
#                    Values > `tmdbApiKey`
# - SUPABASE_*    -> FlutterFlow > Settings > Integrations > Supabase
# Le fichier `.env` sert aux scripts et tests locaux (ex. seed TMDB).

# Clé API v3 TMDB : https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
