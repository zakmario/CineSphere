rules_version = '2';

// CinéSphère — règles Firestore (cahier des charges, section 5.4).
// Tout ce qui n'est pas autorisé ci-dessous est refusé.
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonctions utilitaires ------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Note d'avis : entier de 1 à 10.
    function validRating() {
      return request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 10;
    }

    // Le champ n'est pas modifié par l'écriture.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // Seuls les champs listés changent.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // likesCount varie de ±1.
    function likeDelta() {
      return request.resource.data.likesCount == resource.data.likesCount + 1
          || request.resource.data.likesCount == resource.data.likesCount - 1;
    }

    // Cache TMDB : champs valides et tmdbId = identifiant du document.
    function validCatalogEntry(tmdbId) {
      return request.resource.data.tmdbId is int
          && string(request.resource.data.tmdbId) == tmdbId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.get('rating', 0) is number
          && request.resource.data.get('rating', 0) >= 0
          && request.resource.data.get('rating', 0) <= 10;
    }

    // Profils ----------------------------------------------------------------

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
          && request.resource.data.role == 'user'
          && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid)
          && unchanged('role')
          && unchanged('email');
      allow delete: if isOwner(uid);

      // Données privées : propriétaire uniquement.
      match /favorites/{mediaId} {
        allow read, write: if isOwner(uid);
      }
      match /watched/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(uid);
      }
      match /searchHistory/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Listes : lisibles par les membres connectés si isPublic, écrites par
      // le propriétaire.
      match /watchlists/{watchlistId} {
        allow read: if isOwner(uid)
            || (isSignedIn() && resource.data.isPublic == true);
        allow create, update: if isOwner(uid)
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 60;
        allow delete: if isOwner(uid);

        match /items/{mediaId} {
          allow read: if isOwner(uid)
              || (isSignedIn()
                  && get(/databases/$(database)/documents/users/$(uid)/watchlists/$(watchlistId)).data.isPublic == true);
          allow write: if isOwner(uid);
        }
      }
    }

    // Pseudos : unicité, aucune modification.
    match /usernames/{name} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/usernames/$(name));
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Avis -------------------------------------------------------------------

    match /reviews/{reviewId} {
      allow read: if resource.data.isPrivate == false
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && validRating()
          && request.resource.data.get('content', '') is string
          && request.resource.data.get('content', '').size() <= 2000
          && request.resource.data.likesCount == 0;
      // L'auteur modifie tout sauf userId, mediaType et tmdbId ; les autres
      // membres ne peuvent changer que likesCount, de ±1.
      allow update: if isSignedIn() && (
          (resource.data.userId == request.auth.uid
              && unchanged('userId') && unchanged('mediaType') && unchanged('tmdbId')
              && validRating()
              && (unchanged('likesCount') || likeDelta()))
          || (onlyChanges(['likesCount']) && likeDelta()));
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // L'auteur de l'avis peut aussi effacer les likes des autres, pour
      // supprimer son avis ou son compte sans laisser de likes orphelins.
      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid);
        allow delete: if isOwner(uid)
            || (isSignedIn()
                && get(/databases/$(database)/documents/reviews/$(reviewId)).data.userId == request.auth.uid);
      }
    }

    // Catalogue ---------------------------------------------------------------

    match /movies/{tmdbId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && validCatalogEntry(tmdbId));
      allow delete: if isAdmin();
    }

    match /series/{tmdbId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && validCatalogEntry(tmdbId));
      allow delete: if isAdmin();
    }

    match /genres/{genreId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /platforms/{platformId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /releaseEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Hors cahier des charges : actualités de la page Actualites (membre 2).
    match /news/{newsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
